{% comment %}
  map.js fetches its own jQuery from code.jquery.com (often slow from mainland China) before it starts.
  It reuses window.vmap_jq if it exists, so providing that jQuery up front from jsDelivr lets it start right away.
{% endcomment %}
<script
  src="https://cdn.jsdelivr.net/npm/jquery@1.12.4/dist/jquery.min.js"
  integrity="sha384-nvAa0+6Qg9clwYCGGPpDQLVpLNn0fRaROjHqs13t4Ggj3Ez50XnGQqc/r8MhnRDZ"
  crossorigin="anonymous"
></script>
<script>
  window.vmap_jq = jQuery.noConflict(true);
</script>
<script type="text/javascript" id="mapmyvisitors" src="//mapmyvisitors.com/map.js?d=GlKJzD20S9mm3JJU1Gj_RMQaswnojgPJNOuZ87emg64&cl=ffffff&w=a"></script>
