{% comment %}
  The widget itself lives in /visitor-map.html (see the note there on why it needs its own page).
  180px is the height map.js renders at for a 300px width.
{% endcomment %}
<iframe
  src="{{ '/visitor-map.html' | relative_url }}"
  title="Visitor map"
  width="300"
  height="180"
  scrolling="no"
  style="border: 0; display: block; max-width: 100%"
></iframe>
